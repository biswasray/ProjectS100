+
+/**
+ * @file
+ * Porting layer of the fb application for the JioPhone LF-2403N
+ * (Qualcomm MSM8909, Android 6 / Gonk kernel, KaiOS 2.5 userland).
+ *
+ * Differences from the generic fb_port.c:
+ *  - the display is an Android msm_fb device (/dev/graphics/fb0) that may
+ *    be 16 or 32 bits per pixel, with a line stride that is not width*bpp,
+ *    and that only shows a new frame after FBIOPAN_DISPLAY;
+ *  - the display is blanked when the KaiOS compositor is stopped, so it is
+ *    explicitly unblanked;
+ *  - the keypad is a set of evdev devices (/dev/input/eventN), not a tty.
+ *    All key-capable devices are multiplexed into one epoll descriptor so
+ *    the master mode select() loop keeps seeing a single "keyboard fd".
+ *
+ * Runtime overrides (environment):
+ *   MIDP_FB_DEV      framebuffer device (default /dev/graphics/fb0, /dev/fb0)
+ *   MIDP_KEYPAD_DEV  a single evdev device to use instead of scanning
+ *   MIDP_FB_NOPAN=1  do not issue FBIOPAN_DISPLAY after each refresh
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/epoll.h>
+
+#include <linux/fb.h>
+#include <linux/input.h>
+
+#include <gxj_putpixel.h>
+#include <gxj_screen_buffer.h>
+#include <midp_logging.h>
+#include <midpMalloc.h>
+#include <midp_constants_data.h>
+
+#include <fbapp_device_type.h>
+#include <fbapp_export.h>
+#include <fbport_export.h>
+
+/** @def PERROR Prints diagnostic message. */
+#define PERROR(msg) fprintf(stderr, "%s: %s\n", msg, strerror(errno))
+
+#define DEFAULT_FB_DEV      "/dev/graphics/fb0"
+#define FALLBACK_FB_DEV     "/dev/fb0"
+#define INPUT_DIR           "/dev/input"
+#define MAX_INPUT_DEVICES   16
+
+#ifndef EV_KEY_BITS
+#define BITS_PER_LONG (sizeof(long) * 8)
+#define NBITS(x) ((((x) - 1) / BITS_PER_LONG) + 1)
+#define TEST_BIT(bit, array) ((array[(bit) / BITS_PER_LONG] >> ((bit) % BITS_PER_LONG)) & 1)
+#endif
+
+/** Frame buffer state */
+static struct {
+    int fd;
+    unsigned char *base;      /* mmap()ed memory */
+    unsigned char *data;      /* first visible pixel */
+    int mapsize;
+    int width, height;        /* visible resolution */
+    int depth;                /* bits per pixel: 16 or 32 */
+    int stride;               /* bytes per line */
+    int doPan;
+    struct fb_var_screeninfo vinfo;
+    /* colour channel layout of the device pixel */
+    int rOff, rLen, gOff, gLen, bOff, bLen;
+} fb = { -1, NULL, NULL, 0, 0, 0, 0, 0, 1 };
+
+/** epoll descriptor multiplexing the keypad devices, or -1 */
+static int keyboardFd = -1;
+/** The individual evdev descriptors behind keyboardFd */
+static int inputFds[MAX_INPUT_DEVICES];
+static int inputFdCount = 0;
+
+/** System offscreen buffer */
+gxj_screen_buffer gxj_system_screen_buffer;
+
+/** Return file descriptor of keyboard device, or -1 in none */
+int getKeyboardFd() {
+    return keyboardFd;
+}
+
+/** Return file descriptor of mouse device, or -1 in none */
+int getMouseFd() {
+    return -1;
+}
+
+/** Allocate system screen buffer according to the screen geometry */
+void initScreenBuffer(int width, int height) {
+    if (gxj_init_screen_buffer(width, height) != ALL_OK) {
+        fprintf(stderr, "Failed to allocate screen buffer\n");
+        exit(1);
+    }
+}
+
+/**
+ * Open every /dev/input/event* that reports EV_KEY capability (or only
+ * $MIDP_KEYPAD_DEV) and register them with one epoll descriptor.
+ */
+static void initKeyboard() {
+    const char *only = getenv("MIDP_KEYPAD_DEV");
+    struct epoll_event ev;
+    DIR *dir;
+    struct dirent *de;
+    char path[64];
+
+    keyboardFd = epoll_create(MAX_INPUT_DEVICES);
+    if (keyboardFd < 0) {
+        PERROR("epoll_create");
+        return;
+    }
+
+    if (only != NULL) {
+        /* O_RDWR so that a FIFO (host emulation) never reports EOF and
+         * spins the event loop; evdev nodes accept it as well. */
+        int fd = open(only, O_RDWR | O_NONBLOCK);
+        if (fd < 0) {
+            fd = open(only, O_RDONLY | O_NONBLOCK);
+        }
+        if (fd < 0) {
+            PERROR(only);
+        } else {
+            memset(&ev, 0, sizeof(ev));
+            ev.events = EPOLLIN;
+            ev.data.fd = fd;
+            epoll_ctl(keyboardFd, EPOLL_CTL_ADD, fd, &ev);
+            inputFds[inputFdCount++] = fd;
+        }
+        return;
+    }
+
+    dir = opendir(INPUT_DIR);
+    if (dir == NULL) {
+        PERROR(INPUT_DIR);
+        return;
+    }
+    while ((de = readdir(dir)) != NULL && inputFdCount < MAX_INPUT_DEVICES) {
+        unsigned long evbits[NBITS(EV_MAX)];
+        char name[80];
+        int fd;
+
+        if (strncmp(de->d_name, "event", 5) != 0) {
+            continue;
+        }
+        snprintf(path, sizeof(path), INPUT_DIR "/%s", de->d_name);
+        fd = open(path, O_RDONLY | O_NONBLOCK);
+        if (fd < 0) {
+            continue;
+        }
+        memset(evbits, 0, sizeof(evbits));
+        if (ioctl(fd, EVIOCGBIT(0, sizeof(evbits)), evbits) < 0 ||
+                !TEST_BIT(EV_KEY, evbits)) {
+            close(fd);
+            continue;
+        }
+        name[0] = '\0';
+        ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name);
+        memset(&ev, 0, sizeof(ev));
+        ev.events = EPOLLIN;
+        ev.data.fd = fd;
+        if (epoll_ctl(keyboardFd, EPOLL_CTL_ADD, fd, &ev) < 0) {
+            close(fd);
+            continue;
+        }
+        inputFds[inputFdCount++] = fd;
+        REPORT_INFO2(LC_CORE, "keypad: %s (%s)", path, name);
+    }
+    closedir(dir);
+
+    if (inputFdCount == 0) {
+        fprintf(stderr, "No EV_KEY input device found under " INPUT_DIR "\n");
+    }
+}
+
+/** Close the keypad devices */
+static void restoreConsole() {
+    int i;
+    for (i = 0; i < inputFdCount; i++) {
+        close(inputFds[i]);
+    }
+    inputFdCount = 0;
+    if (keyboardFd >= 0) {
+        close(keyboardFd);
+        keyboardFd = -1;
+    }
+}
+
+/**
+ * Host-side emulation: MIDP_FB_FAKE=<w>x<h>x<bpp> turns $MIDP_FB_DEV (default
+ * /tmp/fb.raw) into a plain file of stride*h bytes that is mmap()ed instead
+ * of a real device. Lets the whole runtime run under qemu-arm on the PC;
+ * scripts/fbdump.py renders the file as PNG. Keys come from MIDP_KEYPAD_DEV,
+ * which may be a FIFO fed with struct input_event records.
+ */
+static int initFakeFrameBuffer(const char *spec, const char *path) {
+    int w, h, bpp;
+
+    if (sscanf(spec, "%dx%dx%d", &w, &h, &bpp) != 3 || (bpp != 16 && bpp != 32)) {
+        fprintf(stderr, "MIDP_FB_FAKE must be <w>x<h>x<16|32>, got '%s'\n", spec);
+        exit(1);
+    }
+    if (path == NULL) {
+        path = "/tmp/fb.raw";
+    }
+    fb.fd = open(path, O_RDWR | O_CREAT, 0644);
+    if (fb.fd < 0) {
+        PERROR(path);
+        exit(1);
+    }
+    fb.width = w;
+    fb.height = h;
+    fb.depth = bpp;
+    fb.stride = w * (bpp / 8);
+    fb.mapsize = fb.stride * h;
+    if (ftruncate(fb.fd, fb.mapsize) < 0) {
+        PERROR("ftruncate");
+        exit(1);
+    }
+    if (bpp == 16) {
+        fb.rOff = 11; fb.rLen = 5; fb.gOff = 5; fb.gLen = 6; fb.bOff = 0; fb.bLen = 5;
+    } else {
+        fb.rOff = 16; fb.rLen = 8; fb.gOff = 8; fb.gLen = 8; fb.bOff = 0; fb.bLen = 8;
+    }
+    fb.doPan = 0;
+    fb.base = (unsigned char *)mmap(0, fb.mapsize, PROT_READ | PROT_WRITE,
+                                    MAP_SHARED, fb.fd, 0);
+    if (fb.base == (unsigned char *)MAP_FAILED) {
+        PERROR("mapping fake framebuffer");
+        exit(1);
+    }
+    fb.data = fb.base;
+    fprintf(stderr, "fake framebuffer %s: %dx%d %dbpp\n", path, w, h, bpp);
+    return 0;
+}
+
+/** Open and map the frame buffer, unblank the panel */
+void initFrameBuffer() {
+    struct fb_fix_screeninfo finfo;
+    const char *dev = getenv("MIDP_FB_DEV");
+    const char *fake = getenv("MIDP_FB_FAKE");
+
+    if (fake != NULL) {
+        initFakeFrameBuffer(fake, dev);
+        return;
+    }
+
+    if (dev == NULL) {
+        dev = DEFAULT_FB_DEV;
+        fb.fd = open(dev, O_RDWR);
+        if (fb.fd < 0) {
+            dev = FALLBACK_FB_DEV;
+        }
+    }
+    if (fb.fd < 0) {
+        fb.fd = open(dev, O_RDWR);
+    }
+    if (fb.fd < 0) {
+        fprintf(stderr, "Can't open framebuffer device %s: %s\n",
+                dev, strerror(errno));
+        exit(1);
+    }
+
+    /* surfaceflinger/b2g blank the panel on exit; turn it back on */
+    if (ioctl(fb.fd, FBIOBLANK, FB_BLANK_UNBLANK) < 0) {
+        REPORT_WARN1(LC_CORE, "FBIOBLANK(UNBLANK) failed: %s", strerror(errno));
+    }
+
+    if (ioctl(fb.fd, FBIOGET_FSCREENINFO, &finfo) ||
+            ioctl(fb.fd, FBIOGET_VSCREENINFO, &fb.vinfo)) {
+        PERROR("reading framebuffer info");
+        exit(1);
+    }
+
+    fb.depth  = fb.vinfo.bits_per_pixel;
+    fb.stride = finfo.line_length;
+    fb.width  = fb.vinfo.xres;
+    fb.height = fb.vinfo.yres;
+    fb.rOff = fb.vinfo.red.offset;   fb.rLen = fb.vinfo.red.length;
+    fb.gOff = fb.vinfo.green.offset; fb.gLen = fb.vinfo.green.length;
+    fb.bOff = fb.vinfo.blue.offset;  fb.bLen = fb.vinfo.blue.length;
+    fb.doPan = (getenv("MIDP_FB_NOPAN") == NULL);
+
+    if (fb.depth != 16 && fb.depth != 32) {
+        fprintf(stderr, "Unsupported framebuffer depth %d (need 16 or 32)\n",
+                fb.depth);
+        exit(1);
+    }
+    if (fb.rLen == 0 || fb.gLen == 0 || fb.bLen == 0) {
+        /* Driver did not fill the bitfields: assume the usual layouts */
+        if (fb.depth == 16) {
+            fb.rOff = 11; fb.rLen = 5; fb.gOff = 5; fb.gLen = 6; fb.bOff = 0; fb.bLen = 5;
+        } else {
+            fb.rOff = 0;  fb.rLen = 8; fb.gOff = 8; fb.gLen = 8; fb.bOff = 16; fb.bLen = 8;
+        }
+    }
+
+    fb.mapsize = finfo.smem_len;
+    fb.base = (unsigned char *)mmap(0, fb.mapsize, PROT_READ | PROT_WRITE,
+                                    MAP_SHARED, fb.fd, 0);
+    if (fb.base == (unsigned char *)MAP_FAILED) {
+        PERROR("mapping framebuffer");
+        exit(1);
+    }
+    fb.data = fb.base + fb.vinfo.yoffset * fb.stride
+                      + fb.vinfo.xoffset * (fb.depth / 8);
+
+    REPORT_INFO4(LC_CORE, "framebuffer %s: %dx%d %dbpp",
+                 dev, fb.width, fb.height, fb.depth);
+    REPORT_INFO4(LC_CORE, "  stride %d, R@%d G@%d B@%d",
+                 fb.stride, fb.rOff, fb.gOff, fb.bOff);
+}
+
+/** Initialize frame buffer video device */
+void connectFrameBuffer() {
+    /* Logs normally go to a file (j2me.log) or a pipe; keep them readable
+     * even when the VM is killed instead of exiting. */
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    setvbuf(stderr, NULL, _IONBF, 0);
+    initKeyboard();
+    initFrameBuffer();
+}
+
+/**
+ * Change screen orientation to landscape or portrait,
+ * depending on the current screen mode
+ */
+void reverseScreenOrientation() {
+    gxj_rotate_screen_buffer(KNI_FALSE);
+}
+
+/**
+ * Resizes system screen buffer to fit new screen geometry
+ * and set system screen dimensions accordingly.
+ * Call after frame buffer is initialized.
+ */
+void resizeScreenBuffer(int width, int height) {
+    if (gxj_resize_screen_buffer(width, height) != ALL_OK) {
+        fprintf(stderr, "Failed to reallocate screen buffer\n");
+        exit(1);
+    }
+}
+
+/** Convert a MIDP 5:6:5 pixel to the device pixel layout */
+static inline unsigned devicePixel(gxj_pixel_type p) {
+    unsigned r = GXJ_GET_RED_FROM_PIXEL(p);     /* 8-bit, low bits zero */
+    unsigned g = GXJ_GET_GREEN_FROM_PIXEL(p);
+    unsigned b = GXJ_GET_BLUE_FROM_PIXEL(p);
+    return ((r >> (8 - fb.rLen)) << fb.rOff) |
+           ((g >> (8 - fb.gLen)) << fb.gOff) |
+           ((b >> (8 - fb.bLen)) << fb.bOff);
+}
+
+/** Store one device pixel at device coordinates (x, y) */
+static inline void putDevicePixel(int x, int y, unsigned v) {
+    unsigned char *p = fb.data + y * fb.stride;
+    if (fb.depth == 16) {
+        ((unsigned short *)p)[x] = (unsigned short)v;
+    } else {
+        ((unsigned int *)p)[x] = v;
+    }
+}
+
+/** Ask the driver to show the frame (needed by msm_fb command mode panels) */
+static void panDisplay() {
+    if (fb.doPan) {
+        fb.vinfo.activate = FB_ACTIVATE_VBL;
+        if (ioctl(fb.fd, FBIOPAN_DISPLAY, &fb.vinfo) < 0) {
+            /* Not every driver implements it; only fail once, loudly */
+            REPORT_WARN1(LC_CORE, "FBIOPAN_DISPLAY failed: %s", strerror(errno));
+            fb.doPan = 0;
+        }
+    }
+}
+
+/** Fill the whole visible frame buffer with one colour */
+void clearScreen() {
+    int x, y;
+    unsigned v = devicePixel((gxj_pixel_type)GXJ_RGB2PIXEL(0xa0 >> 3, 0xa0 >> 2, 0x80 >> 3));
+    for (y = 0; y < fb.height; y++) {
+        for (x = 0; x < fb.width; x++) {
+            putDevicePixel(x, y, v);
+        }
+    }
+    panDisplay();
+}
+
+/** Check if screen buffer is not bigger than frame buffer device */
+static void checkScreenBufferSize(int width, int height) {
+    if (fb.width < width || fb.height < height) {
+        fprintf(stderr, "Device screen too small. Need %dx%d, have %dx%d\n",
+                width, height, fb.width, fb.height);
+        exit(1);
+    }
+}
+
+/** Get x-coordinate of screen origin (MIDP screen centred on the panel) */
+int getScreenX(int screenRotated) {
+    int bufWidth = gxj_system_screen_buffer.width;
+    int LCDwidth = screenRotated ? fb.height : fb.width;
+    return (LCDwidth > bufWidth) ? (LCDwidth - bufWidth) / 2 : 0;
+}
+
+/** Get y-coordinate of screen origin */
+int getScreenY(int screenRotated) {
+    int bufHeight = gxj_system_screen_buffer.height;
+    int LCDheight = screenRotated ? fb.width : fb.height;
+    return (LCDheight > bufHeight) ? (LCDheight - bufHeight) / 2 : 0;
+}
+
+/**
+ * Refresh screen from offscreen buffer. The panel is portrait, the MIDP
+ * buffer is portrait: plain copy with colour conversion.
+ */
+void refreshScreenNormal(int x1, int y1, int x2, int y2) {
+    gxj_pixel_type *src = gxj_system_screen_buffer.pixelData;
+    int bufWidth  = gxj_system_screen_buffer.width;
+    int bufHeight = gxj_system_screen_buffer.height;
+    int ox, oy, x, y;
+
+    checkScreenBufferSize(bufWidth, bufHeight);
+    ox = getScreenX(0);
+    oy = getScreenY(0);
+
+    if (fb.depth == 16 && fb.rOff == 11 && fb.gOff == 5 && fb.bOff == 0) {
+        /* Same 5:6:5 layout as MIDP: straight memcpy per line */
+        int bytes = (x2 - x1) * sizeof(gxj_pixel_type);
+        for (y = y1; y < y2; y++) {
+            memcpy(fb.data + (oy + y) * fb.stride + (ox + x1) * 2,
+                   src + y * bufWidth + x1, bytes);
+        }
+    } else {
+        for (y = y1; y < y2; y++) {
+            gxj_pixel_type *s = src + y * bufWidth + x1;
+            for (x = x1; x < x2; x++) {
+                putDevicePixel(ox + x, oy + y, devicePixel(*s++));
+            }
+        }
+    }
+    panDisplay();
+}
+
+/**
+ * Refresh rotated screen with offscreen buffer content. The MIDP buffer
+ * is landscape (bufWidth > bufHeight); it is drawn rotated 90 degrees
+ * counter-clockwise onto the portrait panel, like the generic port does.
+ */
+void refreshScreenRotated(int x1, int y1, int x2, int y2) {
+    gxj_pixel_type *src = gxj_system_screen_buffer.pixelData;
+    int bufWidth  = gxj_system_screen_buffer.width;
+    int bufHeight = gxj_system_screen_buffer.height;
+    int ox, oy, x, y;
+
+    checkScreenBufferSize(bufHeight, bufWidth);
+    ox = getScreenX(1);   /* offsets in rotated (landscape) space */
+    oy = getScreenY(1);
+
+    for (y = y1; y < y2; y++) {
+        gxj_pixel_type *s = src + y * bufWidth + x1;
+        for (x = x1; x < x2; x++) {
+            /* landscape (x, y) -> portrait (y, W - 1 - x) */
+            int px = oy + y;
+            int py = fb.height - 1 - (ox + x);
+            putDevicePixel(px, py, devicePixel(*s++));
+        }
+    }
+    panDisplay();
+}
+
+/** Frees allocated resources and restore system state */
+void finalizeFrameBuffer() {
+    gxj_free_screen_buffer();
+    restoreConsole();
+    if (fb.base != NULL) {
+        munmap(fb.base, fb.mapsize);
+        fb.base = NULL;
+    }
+    if (fb.fd >= 0) {
+        close(fb.fd);
+        fb.fd = -1;
+    }
+}
