+    {"SELECT", KEYMAP_KEY_SELECT}, {"OK", KEYMAP_KEY_SELECT},
+    {"SOFT1", KEYMAP_KEY_SOFT1}, {"SOFTLEFT", KEYMAP_KEY_SOFT1},
+    {"SOFT2", KEYMAP_KEY_SOFT2}, {"SOFTRIGHT", KEYMAP_KEY_SOFT2},
+    {"CLEAR", KEYMAP_KEY_CLEAR}, {"BACKSPACE", KEYMAP_KEY_BACKSPACE},
+    {"SEND", KEYMAP_KEY_SEND}, {"CALL", KEYMAP_KEY_SEND},
+    {"END", KEYMAP_KEY_END}, {"ENDCALL", KEYMAP_KEY_END},
+    {"POWER", KEYMAP_KEY_POWER},
+    {"SPACE", KEYMAP_KEY_SPACE},
+    {"GAMEA", KEYMAP_KEY_GAMEA}, {"GAMEB", KEYMAP_KEY_GAMEB},
+    {"GAMEC", KEYMAP_KEY_GAMEC}, {"GAMED", KEYMAP_KEY_GAMED},
+    {"HOME", KEYMAP_MD_KEY_HOME}, {"SWITCH_APP", KEYMAP_MD_KEY_SWITCH_APP},
+    {"ROTATE", KEYMAP_KEY_SCREEN_ROT}, {"VIRT_KEYB", KEYMAP_KEY_VIRT_KEYB},
+    {"IGNORE", KEYMAP_KEY_INVALID},
+    {NULL, 0}
+};
+
+#define MAX_FILE_KEYS 128
+static KeyMapping fileKeys[MAX_FILE_KEYS + 1];
+
+/**
+ * Load "<linux keycode> <name>" lines (blank lines and # comments allowed)
+ * into fileKeys[]. Unknown names are reported and skipped.
+ */
+KeyMapping *load_keymap_file(const char *path) {
+    FILE *f = fopen(path, "r");
+    char line[128];
+    int n = 0;
+
+    if (f == NULL) {
+        return NULL;
+    }
+    while (n < MAX_FILE_KEYS && fgets(line, sizeof(line), f) != NULL) {
+        char name[32];
+        unsigned code;
+        int i;
+
+        if (line[0] == '#' || sscanf(line, "%u %31s", &code, name) != 2) {
+            continue;
+        }
+        for (i = 0; keymapNames[i].name != NULL; i++) {
+            if (strcasecmp(name, keymapNames[i].name) == 0) {
+                break;
+            }
+        }
+        if (keymapNames[i].name == NULL) {
+            fprintf(stderr, "keymap %s: unknown key name '%s'\n", path, name);
+            continue;
+        }
+        fileKeys[n].midp_keycode = keymapNames[i].midp_keycode;
+        fileKeys[n].raw_keydown = code;
+        fileKeys[n].raw_keyup = code;
+        n++;
+    }
+    fclose(f);
+    fileKeys[n].midp_keycode = KEYMAP_KEY_INVALID;
+    fileKeys[n].raw_keydown = 0;
+    fileKeys[n].raw_keyup = 0;
+    return (n > 0) ? fileKeys : NULL;
+}
