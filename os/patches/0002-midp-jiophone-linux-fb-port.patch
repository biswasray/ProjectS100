+/**
+ * Update input keys state from a Linux evdev keypad. The keyboard fd is an
+ * epoll descriptor: find the device that woke us and read one input_event.
+ * Only EV_KEY press (1) / release (0) are reported; the driver's own
+ * auto-repeat (2) is dropped because MIDP generates repeats by timer.
+ */
+jboolean read_evdev_key_event() {
+    struct input_event ie;
+    struct epoll_event ev;
+    int n, readBytes;
+
+    n = epoll_wait(fbapp_get_keyboard_fd(), &ev, 1, 0);
+    if (n <= 0) {
+        return KNI_FALSE;
+    }
+    readBytes = read(ev.data.fd, &ie, sizeof(ie));
+    if (readBytes < (int)sizeof(ie)) {
+        return KNI_FALSE;
+    }
+    if (ie.type != EV_KEY || ie.value > 1) {
+        return KNI_FALSE;
+    }
+    keyState.km = mapping;
+    keyState.changedBits = 0;
+    keyState.key = ie.code;
+    keyState.down = ie.value;
+    return KNI_TRUE;
+}
