diff --git a/midp/src/configuration/configuration_xml/linux_fb/constants_jiophone.xml b/midp/src/configuration/configuration_xml/linux_fb/constants_jiophone.xml
new file mode 100644
index 0000000..35a6029
--- /dev/null
+++ b/midp/src/configuration/configuration_xml/linux_fb/constants_jiophone.xml
@@ -0,0 +1,69 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE configuration SYSTEM "../share/configuration.dtd">
+<!--
+        JioPhone LF-2403N (Qualcomm MSM8909, KaiOS 2.5 / Gonk userland)
+        device constants for the linux_fb port.
+
+        2.4" QVGA portrait LCD (240x320) on /dev/graphics/fb0, evdev keypad
+        (12 keys, D-pad + centre, two soft keys, call, end/power) with no
+        pointer. The keypad driver auto-repeats, but MIDP's own timer based
+        repeat is used so the repeat rate is the same on every device.
+-->
+<configuration>
+<constants>
+<constant_class Package="com.sun.midp.configurator" Name="Constants" Scope="public">
+  <constant Type="int"
+            Name="CHAM_WIDTH"
+            Value="240"
+            Comment="(Chameleon Only) display width"/>
+  <constant Type="int"
+            Name="CHAM_FULLWIDTH"
+            Value="240"
+            Comment="(Chameleon Only) full display width"/>
+  <constant Type="int"
+            Name="CHAM_HEIGHT"
+            Value="320"
+            Comment="(Chameleon Only) display height"/>
+  <constant Type="int"
+            Name="CHAM_FULLHEIGHT"
+            Value="320"
+            Comment="(Chameleon Only) full display height"/>
+  <constant Type="int"
+            Name="FULLWIDTH"
+            Value="240"
+            Comment="(Fixed) full display width"/>
+  <constant Type="int"
+            Name="FULLHEIGHT"
+            Value="320"
+            Comment="(Fixed) full display height"/>
+  <constant Type="int"
+            Name="NORMALWIDTH"
+            Value="240"
+            Comment="(Fixed) normal width"/>
+  <constant Type="int"
+            Name="NORMALHEIGHT"
+            Value="320"
+            Comment="(Fixed) normal height"/>
+  <constant Type="boolean"
+            Name="POINTER_SUPPORTED"
+            Value="false"
+            Comment="Whether both the platform and MIDP implementation provide support for a pointer (press and release). Set to true when pointer is supported; set to false when pointer is not supported."/>
+  <constant Type="boolean"
+            Name="MOTION_SUPPORTED"
+            Value="false"
+            Comment="If your platform supports pointer motion and you want MIDP implementation provides support for pointer motions, set it to true; otherwise, set it to false so that MIDP runtime can provide this information to MIDlet."/>
+  <constant Type="boolean"
+            Name="REPEAT_SUPPORTED"
+            Value="true"
+            Comment="If your platform support key repeat and you want MIDP implementation provides support for key repeat, set this to true, otherwise set it to false."/>
+  <constant Type="int"
+             Name="REPEAT_TIMEOUT"
+             Value="400"
+             Comment="If your platform support key repeat and you want MIDP implementation needs to support key repeat, set this to value of timeout before repeat key event generation."/>
+  <constant Type="int"
+             Name="REPEAT_PERIOD"
+             Value="80"
+             Comment="If your platform support key repeat and you want MIDP implementation needs to support key repeat, set this to value of period between next repeat key event generation."/>
+ </constant_class>
+</constants>
+</configuration>
