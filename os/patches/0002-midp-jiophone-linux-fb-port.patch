diff --git a/midp/build/common/makefiles/gcc.gmk b/midp/build/common/makefiles/gcc.gmk
index 0184ff1..cc79ac7 100644
--- a/midp/build/common/makefiles/gcc.gmk
+++ b/midp/build/common/makefiles/gcc.gmk
@@ -96,13 +96,14 @@ CC_OUTPUT	= -o
 
 LD		= $(GNU_TOOLS_BINDIR)g++$(GCC_VERSION)
 LINKER_OUTPUT	?= -o
-GCC_LIBS ?= -lpthread -lm -lnsl
+# libnsl was folded into libc by glibc 2.26 (no libnsl.a in the cross sysroot)
+GCC_LIBS ?= -lpthread -lm
 LIBS     += $(GCC_LIBS)
 
 # Options to force single-pass linker to search undefined references repeatly.
 # Note. '-Wl,' option cannot be used instead of -Xlinker
 LD_START_GROUP ?= -Xlinker --start-group
-LD_END_GROUP ?= --end-group
+LD_END_GROUP ?= -Xlinker --end-group
 
 AR		= $(GNU_TOOLS_BINDIR)ar
 AR_FLAGS	= -rcs
@@ -125,9 +126,12 @@ ifneq ($(TARGET_VM), cdc_vm)
 # CDC port is not yet clear of warnings.
 ifneq ($(TARGET_OS), javacall)
 # javacall is not clear of warnings
+# USE_COMPILATION_WARNINGS=true keeps warnings from newer compilers non-fatal
+ifneq ($(USE_COMPILATION_WARNINGS), true)
 EXTRA_CFLAGS	+= -Werror
 endif
 endif
+endif
 
 include $(MIDP_DIR)/build/common/makefiles/gcc-warnings.gmk
 
diff --git a/midp/build/linux_fb_gcc/Platform.gmk b/midp/build/linux_fb_gcc/Platform.gmk
index 7581ba5..3cb5188 100644
--- a/midp/build/linux_fb_gcc/Platform.gmk
+++ b/midp/build/linux_fb_gcc/Platform.gmk
@@ -53,6 +53,14 @@ TARGET_DEVICE		= x86
 endif
 endif
 
+ifeq ($(TARGET_DEVICE), jiophone)
+# JioPhone LF-2403N: pick the jiophone fb port at compile time and link the
+# executables statically -- the Gonk (bionic) userland has no glibc, so a
+# static glibc binary is the only thing that runs there.
+EXTRA_CFLAGS		+= -DLINUX_FB_DEFAULT_DEVICE=LINUX_FB_JIOPHONE
+LD_FLAGS		+= -static
+endif
+
 # file/directory name separator ( / or \\\\ )
 # if the file separator is backslash, double-quoting is needed,
 # that is, you need to write "\\\\" (four backslashes) for "\" (one backslash)
