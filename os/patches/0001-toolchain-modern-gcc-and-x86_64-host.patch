@@ -641,7 +641,7 @@ BUILD_FLAGS_HPP = $(WorkSpace)/src/vm/share/utilities/BuildFlags.hpp
 
 $(GEN_DIR)/jvmconfig.h:	$(BUILDTOOL_JAR) $(BUILD_FLAGS_HPP) $(GEN_DIR)/platform
 	$(A)if test ! -d $(GEN_DIR); then \
