@@ -761,7 +761,11 @@ VerifyFile(char *fn)
                 }
             }
             WriteClass(cb);
-            Str2IDFree_Local(&nameTypeHash);
+            /* Do NOT free nameTypeHash here. Already-loaded classes keep
+             * fieldblock IDs allocated from this table; resetting it lets a
+             * later class receive an ID that an earlier class (e.g.
+             * java.lang.Object.wait) already holds, and ResolveMethods then
